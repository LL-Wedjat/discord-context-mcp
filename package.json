{
  "name": "discord-context-mcp",
  "version": "1.0.0",
  "description": "Read-only Discord context MCP server for AI agents (DMs and server channels, local SQLite cache)",
  "type": "module",
  "main": "src/index.js",
  "bin": {
    "discord-context-mcp": "src/index.js"
  },
  "files": [
    "src/",
    "scripts/",
    "README.md",
    "LICENSE",
    "RELEASE_NOTES.md"
  ],
  "engines": {
    "node": ">=26"
  },
  "author": "Hosam Tamer",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Wedjat/discord-context-mcp.git"
  },
  "homepage": "https://github.com/Wedjat/discord-context-mcp#readme",
  "bugs": {
    "url": "https://github.com/Wedjat/discord-context-mcp/issues"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "check": "node scripts/setup.mjs --check",
    "test": "node tests/test.mjs && node tests/smoke.mjs",
    "smoke": "node tests/smoke.mjs",
    "start": "node src/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.6.1",
    "ws": "^8.18.0",
    "zod": "^3.23.8"
  }
}
